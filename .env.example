# ─────────────────────────────────────────────
# MediAssist AI - Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git!
# ─────────────────────────────────────────────

# LLM Providers (set at least ONE)
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Web Search (optional — DuckDuckGo is used as free fallback)
TAVILY_API_KEY=tvly-...
